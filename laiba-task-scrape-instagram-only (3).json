            }
          ]
        },
        "options": {}
      },
      "id": "6f339c28-a839-4a5b-b2db-cf943cc9d7f4",
      "name": "HTML Extract Links",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        384,
        88
      ],
      "onError": "continueRegularOutput",
      "notes": "Only extracts <a> tags whose href contains instagram.com \u2014 skips every other link on the page instead of pulling all links and filtering afterward."
    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const links = item.json.links || [];\n  const original = $('Has Website?').item.json;\n\n  // If Google Maps' own \"website\" field already IS an Instagram profile\n  // (very common for small businesses that never built a real site),\n  // use it directly \u2014 no need to trust the page-scrape result for it.\n  const websiteField = String(original.website || '');\n  let instagramLink = websiteField.includes('instagram.com') ? websiteField : '';\n\n  if (!instagramLink) {\n    instagramLink = Array.isArray(links)\n      ? links.find((l) => typeof l === 'string' && l.includes('instagram.com')) || ''\n      : '';\n  }\n\n  items.push({\n    json: {\n      ...original,\n      instagram: instagramLink\n    }\n  });\n}\n\nreturn items;"
      },
