    {
      "parameters": {
        "jsCode": "// Build a de-dup set from everything already in the sheet, keyed on\n// normalized website (or normalized business name if no website).\n// Stored in workflow static data so later nodes can check against it\n// even across different niches/locations run today.\nfunction normalizeWebsite(url) {\n  if (!url) return '';\n  return String(url).toLowerCase().trim()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/^www\\./, '')\n    .replace(/\\/+$/, '');\n}\nfunction normalizeName(name) {\n  return String(name || '').toLowerCase().trim().replace(/\\s+/g, ' ');\n}\n\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const website = item.json['Website'] || '';\n  const name = item.json['Business name'] || '';\n  const key = normalizeWebsite(website) || normalizeName(name);\n  if (key) seen.add(key);\n}\n\nstaticData.seenKeys = Array.from(seen);\nreturn [{ json: { existingLeadsCount: seen.size } }];"
      },
      "id": "gexlead001-0002-4000-8000-000000000002",
      "name": "Build Dedup Set",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1960,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// EDIT THIS to scrape a new niche/location.\n// Nothing else in the workflow needs to change.\n//\n// Same service-provider niches as the Karachi run (these are the\n// businesses that would actually want the company's software),\n// now spread across cities other than Lahore/Karachi.\n//\n// Cost guide: total Apify usage this run \u2248\n//   searchStringsArray.length x maxCrawledPlacesPerSearch\n// Check your remaining Apify credit balance before raising these.\n// ============================================\nconst searchStringsArray = [\n  \"Digital marketing agencies in Islamabad\",\n  \"Digital marketing agencies in Rawalpindi\",\n  \"Web development agencies in Faisalabad\",\n  \"Web development agencies in Multan\",\n  \"Graphic design services in Peshawar\",\n  \"Graphic design services in Gujranwala\",\n  \"Advertising agencies in Hyderabad\",\n  \"Advertising agencies in Sialkot\",\n  \"Event management companies in Islamabad\",\n  \"Event management companies in Rawalpindi\",\n  \"Interior design services in Faisalabad\",\n  \"Interior design services in Multan\",\n  \"Photography studios in Peshawar\",\n  \"Photography studios in Gujranwala\",\n  \"IT services companies in Hyderabad\",\n  \"IT services companies in Sialkot\"\n];\n\nconst maxCrawledPlacesPerSearch = 80; // 16 queries x 80 = 1,280 places (fits ~$3.3 of remaining budget)\n\nreturn [{\n  json: { searchStringsArray, maxCrawledPlacesPerSearch }\n}];"
      },
      "id": "gexlead001-0003-4000-8000-000000000003",
      "name": "Search Config (EDIT ME)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1740,
        200
      ]
    },
