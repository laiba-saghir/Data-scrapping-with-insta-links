    {
      "parameters": {
        "jsCode": "// Normalize output so we get one item per business,\n// regardless of whether the HTTP node auto-split the array\n// or returned it as a single item wrapping the array.\nconst inputItems = $input.all();\nlet businesses = [];\n\nfor (const item of inputItems) {\n  if (Array.isArray(item.json)) {\n    businesses.push(...item.json);\n  } else {\n    businesses.push(item.json);\n  }\n}\n\nreturn businesses.map((b) => ({ json: b }));"
      },
      "id": "21c1060d-196b-45e5-87a4-a6713e15c950",
      "name": "Normalize Businesses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -736,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Dedupe across the 6 overlapping search queries.\n// Prefer Apify's placeId (stable, unique per business).\n// Fall back to title+address if placeId is ever missing.\nconst seen = new Set();\nconst deduped = [];\nlet duplicateCount = 0;\n\nfor (const item of $input.all()) {\n  const b = item.json;\n  const key = b.placeId\n    ? `id:${b.placeId}`\n    : `fallback:${(b.title || '').trim().toLowerCase()}|${(b.address || '').trim().toLowerCase()}`;\n\n  if (seen.has(key)) {\n    duplicateCount++;\n    continue;\n  }\n  seen.add(key);\n  deduped.push({ json: b });\n}\n\nconsole.log(`Deduped ${duplicateCount} duplicate leads across overlapping search queries. ${deduped.length} unique leads remain.`);\nreturn deduped;"
      },
      "id": "c3d4e5f6-a7b8-4c5d-9e0f-1a2b3c4d5e6f",
      "name": "Deduplicate Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        200
      ],
      "notes": "6 queries covering overlapping areas of Lahore WILL return the same business more than once. Without this, you'd double-bill Apify credits fetching the same website twice and write duplicate rows to the sheet."
    },
    {
      "parameters": {
        "jsCode": "// Drop anything already present in the sheet from a previous run\n// (any niche/location) \u2014 checked against the set built at the start.\nfunction normalizeWebsite(url) {\n  if (!url) return '';\n  return String(url).toLowerCase().trim()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/^www\\./, '')\n    .replace(/\\/+$/, '');\n}\nfunction normalizeName(name) {\n  return String(name || '').toLowerCase().trim().replace(/\\s+/g, ' ');\n}\n\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set(staticData.seenKeys || []);\nconst unique = [];\nlet skipped = 0;\n\nfor (const item of $input.all()) {\n  const b = item.json;\n  const key = normalizeWebsite(b.website) || normalizeName(b.title);\n  if (!key || seen.has(key)) { skipped++; continue; }\n  seen.add(key);\n  unique.push(item);\n}\n\nstaticData.seenKeys = Array.from(seen);\nconsole.log(`Skipped ${skipped} leads already in the sheet from a previous run. ${unique.length} genuinely new leads remain.`);\nreturn unique;"
      },
